<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Types input in HTML">
    <title>Input Types</title>
    <link rel="stylesheet" href="stylesinput.css">
</head>
<body>
<table>
    <thead>
    <tr><th colspan="3"> Types input</th></tr>
    <tr>
        <th>type</th>
        <th>field example</th>
        <th>description</th>
    </tr>
    </thead>
    <tbody>
    <!-- split the inputs --><tr>
        <td><code>1. text</code></td><td><input type="text" placeholder="just text"></td><td>write a little text</td>
    </tr>
    <!-- split the inputs -->
    <tr>
        <td><code>2. email</code></td><td><input type="email" placeholder="user@example.com" required></td><td>field for email</td>
    </tr>
    <!-- split the inputs -->
    <tr>
        <td><code>3. password</code></td><td><input type="password" placeholder="********" required></td><td>field for password</td>
    </tr>
    <!-- split the inputs -->
    <tr>
        <td><code>4. tel</code></td><td><input type="tel" placeholder="+1 (111) 111-11-11 " required></td><td>telephone number</td>
    </tr>
    <!-- split the inputs -->
    <tr>
        <td><code>5. url</code></td><td><input type="url" placeholder="https://example.com"></td><td>URL address</td>
    </tr>
    <!-- split the inputs -->
    <tr>
        <td><code>6. search</code></td><td><input type="search" placeholder="search"></td><td>field for search</td>
    </tr>
    <!-- split the inputs -->
    <tr>
        <td><code>7. color</code></td><td><input type="color" value="#437C94"></td><td>choose a color</td>
    </tr>
    <!-- split the inputs -->
    <tr>
        <td><code>8. date</code></td><td><input type="date" ></td><td>day.month.year</td>
    </tr>
    <!-- split the inputs -->
    <tr>
        <td><code>9. time</code></td><td><input type="time" ></td><td>choose a time</td>
    </tr>
    <!-- split the inputs -->
    <tr>
        <td><code>10. range</code></td><td><input type="range" min="0" max="100" value="100" ></td><td>choose a range, for instance volume control</td>
    </tr>
    <!-- split the inputs -->
    <tr>
        <td><code>11. file</code></td>
        <td>
            <form id="11loadForm">
                    <input type="file" id="11loadFile" name="11loadedFile" class="input-file" required>
                    <input type="submit" value="Upload" class="input-eleven">
            </form>

            <div id="successMessage" style="display:none; color:green;">Success</div>
            <div id="errorMessage" style="display:none; color:red;">Error</div>

        </td><td>choose a file</td>
    </tr>

    <!-- split the inputs -->
    <tr>
        <td><code>12. checkbox</code></td><td><input type="checkbox" value="3"></td><td>choose</td>
    </tr>
    <!-- split the inputs -->
    <tr>
        <td><code>13. button</code></td>
            <td><input type="button" value=button id="buttonInput" class="input-cell"> </td>
        <td>A button</td>
    </tr>
    <!-- split the inputs -->
    <tr>
        <td><code>14. submit</code></td><td><input type="submit" value="submit" id="submitInput" class="input-cell"></td><td>send</td>
    </tr>
    <!-- split the inputs -->
    <tr>
        <td><code>15. reset</code></td><td><input type="reset" value="reset" id="resetInput" class="input-cell"></td><td>cancels changes</td>
    </tr>
    <!-- split the inputs -->
    <tr>
        <td><code>16. image</code></td><td><input type="image" src="link to a picture" alt></td><td>put a picture</td>
    </tr>
    <!-- split the inputs -->
    </tbody>
    <tfoot>
    <tr>
        <td><code>17. hidden</code></td><td><input type="hidden" ></td><td>A user shouldnt see it, only for us</td>
    </tr>
    </tfoot>
</table>
</body>

<script>
    document.getElementById('11loadForm').addEventListener('submit', function(e) {
        e.preventDefault();

        const fileInput = document.getElementById('11loadFile');
        const file = fileInput.files[0];

        if (!file) {
            alert('choose file');
            return;
        }

        const formData = new FormData();
        formData.append('11loadedFile', file);

        fetch('/NameFile', {
            method: 'POST',
            body: formData
        })
            .then(response => {
                if (response.ok) {
                    document.getElementById('successMessage').style.display = 'block';
                    fileInput.value = ''
                    setTimeout(() => {
                        document.getElementById('successMessage').style.display = 'none';
                    }, 5000);
                } else {
                    throw new Error('Server error');
                }
            })
            .catch(error => {
                console.error('error:', error);
                document.getElementById('errorMessage').style.display = 'block';
                setTimeout(() => {
                    document.getElementById('errorMessage').style.display = 'none';
                }, 5000);
            });
    });
</script>

</html>
